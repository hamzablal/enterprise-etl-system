{
  "dashboard": {
    "id": null,
    "title": "Enterprise ETL Pipeline Dashboard",
    "tags": ["etl", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Pipeline Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "etl_pipeline_success_total / etl_pipeline_runs_total * 100",
            "legendFormat": "Success %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 2,
        "title": "Records Processed Today", 
        "type": "stat",
        "targets": [
          {
            "expr": "records_processed_total",
            "legendFormat": "Records"
          }
        ]
      },
      {
        "id": 3,
        "title": "Data Quality Tests",
        "type": "stat",
        "targets": [
          {
            "expr": "dbt_test_failures_total",
            "legendFormat": "Failed Tests"
          }
        ]
      },
      {
        "id": 4,
        "title": "Processing Volume Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "records_processed_total",
            "legendFormat": "Records Processed"
          }
        ]
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "30s"
  }
}