{
  "dashboard": {
    "id": null,
    "title": "ETL Pipeline Dashboard - Working Version",
    "tags": ["etl"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Total Records in Raw Data",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) as total_records FROM raw.ecommerce_transactions;",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Database Tables",
        "type": "table",
        "targets": [
          {
            "rawSql": "SELECT schemaname, tablename, n_tup_ins as inserts FROM pg_stat_user_tables ORDER BY n_tup_ins DESC LIMIT 10;",
            "format": "table",
            "refId": "B"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}